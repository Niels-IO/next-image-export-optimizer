{
  "name": "@mrkamel/next-image-export-optimizer",
  "version": "0.0.2",
  "description": "Optimizes all static images for Next.js static HTML export functionality",
  "type": "module",
  "main": "dist/ExportedImage.js",
  "types": "dist/ExportedImage.d.ts",
  "bin": "dist/cli.js",
  "engines": {
    "node": ">=16.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/ExportedImage.d.ts",
      "import": "./dist/ExportedImage.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mrkamel/next-image-export-optimizer"
  },
  "keywords": [
    "next.js",
    "next",
    "static",
    "export",
    "image",
    "optimization",
    "webp",
    "sharp"
  ],
  "author": "Niels Grafen",
  "license": "MIT",
  "dependencies": {
    "sharp": "^0.34.5",
    "typescript": "^5.2.2"
  },
  "peerDependencies": {
    "next": "^14.2.18 || ^15.0.3 || ^16.0.0",
    "react": "^18.2.0 || ^19.0.0-0 "
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.1.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.7",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.33.2",
    "happy-dom": "^20.6.3",
    "react-dom": "^19.2.3",
    "vitest": "^3.1.0"
  }
}
